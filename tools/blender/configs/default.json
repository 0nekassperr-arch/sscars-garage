{
  "version": "1.0.0",
  "name": "Default SSCARS Vehicle Config",
  "target_length_mm": 70.0,
  "axes": {
    "width": "X",
    "length": "Y",
    "height": "Z",
    "front_positive_y": true,
    "up_positive_z": true
  },
  "confidence_thresholds": {
    "auto_accept": 0.85,
    "review_required": 0.60,
    "fail": 0.35
  },
  "wheels": {
    "expected_radius_range_mm": [9.0, 16.0],
    "expected_width_range_mm": [5.0, 12.0],
