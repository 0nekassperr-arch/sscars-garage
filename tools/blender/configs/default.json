    "normal_alignment_threshold": 0.75,
    "crease_angle_deg": 35.0
  },
  "body": {
    "min_volume_ratio": 0.50
  },
  "spoiler": {
    "search_y_ratio": -0.20,
    "search_z_ratio": 0.60
  },
  "exhaust": {
    "search_y_ratio": -0.40,
    "search_z_ratio": 0.35
  },
  "undercarriage": {
    "min_ground_clearance_mm": 1.8,
    "detect_flat_closure": true,
    "auto_clean_bottom": false
  },
