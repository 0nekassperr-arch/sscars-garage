    "master_blend": true,
    "web_glb": {
      "enabled": true,
      "draco_compression": true,
      "target_size_kb": 1500,
      "reduce_polygons": false
    },
    "print_3mf": {
      "enabled": true,
      "hollow_thickness_mm": 2.0,
      "drainage_hole_mm": 4.0
    }
  }
