# ---------- Stripe (obligatorio para cobrar) ----------
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_BOX1=price_xxx    # 24,95 € (1 caja)
STRIPE_PRICE_BOX3=price_xxx    # 69,95 € (pack 3)
STRIPE_PRICE_BOX6=price_xxx    # 129,95 € (pack 6)
STRIPE_PRICE_FULL=price_xxx    # 669,95 € (colección completa)

# ---------- Fabricación bajo demanda ----------
FABRICANTE=jlc3dp              # proveedor: jlc3dp | printeers | shapeways | marketiger3d
JLC_API_KEY=xxx                # si está vacío -> modo manual (te avisa por email)
STL_BASE_URL=https://tu-storage/stl
MODEL_EXT=3mf                  # extensión de los ficheros: 3mf | stl | obj

# ---------- Persistencia (Upstash Redis, plan gratuito) ----------
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx

# ---------- Avisos por email (Resend, plan gratuito) ----------
RESEND_API_KEY=re_xxx
ALERT_EMAIL=tu@email.com
FROM_EMAIL=SSCARS <pedidos@tudominio.com>

# ---------- Panel privado ----------
ADMIN_KEY=pon-aqui-una-cadena-larga-aleatoria
